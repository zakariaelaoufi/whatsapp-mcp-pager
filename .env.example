# Your personal WhatsApp number in international format WITHOUT '+' or spaces, followed by @c.us
# Example: 14155552671@c.us
MY_WHATSAPP_ID=1XXXXXXXXXX@c.us

# Your personal phone number in E.164 format for the 6-second cellular wake-up ring (if WAKEUP_MODE=twilio)
MY_PHONE_E164=+1XXXXXXXXXX

# Optional: OpenAI API Key (Used for Opus TTS voice notes and Whisper STT; if omitted, runs in text-only mode)
OPENAI_API_KEY=

# Optional: Groq API Key (If set, uses Groq's whisper-large-v3-turbo for ultra-fast STT)
GROQ_API_KEY=

# Wake-up Call Mode: "puppeteer" (clicks WhatsApp Web call button) or "twilio" (cellular flash call)
WAKEUP_MODE=puppeteer

# Optional: Twilio Credentials (Only needed if WAKEUP_MODE=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Escalation timeout in milliseconds (default: 60000 = 60 seconds)
ESCALATION_TIMEOUT_MS=60000

# Per-request countdown in seconds (decrements N -> ... -> 0 while waiting; only sends WhatsApp reminder if wait exceeds countdown)
REMINDER_COUNTER=15

# Optional: Quiet hours in HH:MM-HH:MM 24h local format (suppresses the 60s wake-up ring during sleep hours, e.g. 23:00-07:00)
QUIET_HOURS=

# Optional: SQLite database path (default: ./.hitl.sqlite)
DB_PATH=./.hitl.sqlite
